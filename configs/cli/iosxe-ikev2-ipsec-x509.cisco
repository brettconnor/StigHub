! IOS XE site-to-site IPsec VPN template using X.509 and route-based VTIs.
! Use this OR iosxe-ikev2-ipsec-psk.cisco, not both.
! Replace all placeholders and validate platform/release support before use.
! WAN IP ingress is restricted to peer-specific IKE and ESP only.
! Add approved routing and authorization for decrypted tunnel traffic.
! Static WAN addressing/next hops are assumed; DHCP, RA, routing protocols,
! and direct WAN management are blocked. Deploy with console/OOB access.
! ICMP/ICMPv6 (including ND and PMTU errors) is also blocked. IPv6 requires
! an approved alternative to dynamic neighbor discovery; PMTU may fail.
! IPv4 ARP is Layer 2 and is not filtered by these IP ACLs.
!
! X.509 prerequisites: provision a dedicated non-exportable P-256 EC key
! named VPN-IDENTITY-KEY and a CA-issued router identity certificate.
! Example key generation (once): crypto key generate ec keysize 256 label VPN-IDENTITY-KEY
! Authenticate the approved CA chain out of band, verify its fingerprints,
! and enroll/import the identity certificate into VPN-TP before use.
! No private keys or certificate payloads belong in this template.
! Verify certificate validity, SHA-256-or-stronger signatures, key usage,
! and the complete chain; retain trusted time and reachable OCSP/CRL services.
! Prefer OCSP; try CRL if OCSP cannot determine status. Verify fallback
! support and behavior on the target; a revoked certificate must be rejected.
! Use issued certificate AIA/CDP locations for OCSP/CRL retrieval.
! Retrieval needs a permitted path (e.g. OOB); the WAN ACL below is
! unchanged and may block retrieval replies. Do not bypass revocation.
! Confirm ECDSA IKEv2/PKI support on the exact PID/release, including
! in-scope ISR 4000 and ASR 1000 releases; no PSK fallback is configured.
crypto pki trustpoint VPN-TP
 enrollment terminal pem
 subject-name <LOCAL-ROUTER-SUBJECT-DN>
 revocation-check ocsp crl
 eckeypair VPN-IDENTITY-KEY
 hash sha256
!
! Peer authZ: exact approved leaf subject and issuer, ANDed in each map.
! Use full DNs in IOS certificate-map format, not a CA-wide substring.
! Both paths may use the same peer certificate or separate approved peers.
! These maps authorize router identities, not users or inner LAN traffic.
crypto pki certificate map VPN-PEER4 10
 subject-name eq <IPSEC-PEER-SUBJECT-DN>
 issuer-name eq <IPSEC-PEER-ISSUER-DN>
!
crypto pki certificate map VPN-PEER6 10
 subject-name eq <IPSEC-PEER6-SUBJECT-DN>
 issuer-name eq <IPSEC-PEER6-ISSUER-DN>
!
! IKEv2 proposal. GCM provides authenticated encryption; no separate
! integrity transform is configured for AES-GCM.
crypto ikev2 proposal IKE2-PROP
 encryption aes-gcm-256
 prf sha256
 group 19
!
crypto ikev2 policy IKE2-POLICY
 proposal IKE2-PROP
!
! Local-address matching is ANDed with the certificate map and separates
! profiles even when the IPv4 and IPv6 paths use the same peer certificate.
! Do not add a remote-address/identity match as an alternative: IOS ORs it
! with match certificate, which would bypass the certificate allowlist.
crypto ikev2 profile IKE2-PROFILE
 match address local <WAN-IP>
 match certificate VPN-PEER4
 identity local dn
 authentication remote ecdsa-sig
 authentication local ecdsa-sig
 pki trustpoint VPN-TP
 dpd 30 6 periodic
!
crypto ikev2 profile IKE2-PROFILE6
 match address local <WAN-IP6>
 match certificate VPN-PEER6
 identity local dn
 authentication remote ecdsa-sig
 authentication local ecdsa-sig
 pki trustpoint VPN-TP
 dpd 30 6 periodic
!
! AES-GCM is an AEAD transform and does not use a separate ESP HMAC.
crypto ipsec transform-set TSET_Tunnel esp-gcm 256
 mode tunnel
!
crypto ipsec profile TNL_Profile
 set transform-set TSET_Tunnel
 set ikev2-profile IKE2-PROFILE
!
crypto ipsec profile TNL_Profile6
 set transform-set TSET_Tunnel
 set ikev2-profile IKE2-PROFILE6
!
interface Tunnel <TUN-INT>
 ip address <TUN-IP> <TUN-MASK>
 tunnel source <WAN-IP>
 tunnel mode ipsec ipv4
 tunnel destination <IPSEC-PEER-IP>
 tunnel protection ipsec profile TNL_Profile
!
interface Tunnel <TUN-INT6>
 bandwidth inherit
 no ip address
 ipv6 address <TUN-IP6>/<TUN-PREFIX>
 ipv6 mtu 1280
 tunnel source <WAN-IP6>
 tunnel mode ipsec ipv6
 tunnel destination <IPSEC-PEER-IP6>
 tunnel path-mtu-discovery
 tunnel protection ipsec profile TNL_Profile6
!
! IKE must reach IKE/IPsec processing; an ACL permit is not authentication.
ip access-list extended WAN-VPN-IN
 permit udp host <IPSEC-PEER-IP> host <WAN-IP> eq 500
 permit esp host <IPSEC-PEER-IP> host <WAN-IP>
 deny ip any any
!
ipv6 access-list WAN-VPN6-IN
 permit udp host <IPSEC-PEER-IP6> host <WAN-IP6> eq 500
 permit esp host <IPSEC-PEER-IP6> host <WAN-IP6>
 deny ipv6 any any
!
! Apply to the outer WAN L3 interface, NOT the decrypted tunnel interface.
! Validate the platform's VTI/ACL processing order and tunnel data flow.
! Option A: routed Layer 3 WAN interface. Use this OR Option B.
interface <WAN-INT>
 ip address <WAN-IP> <WAN-SUBNET>
 ip access-group WAN-VPN-IN in
 ip tcp adjust-mss 1300
 load-interval 30
 negotiation auto
 ipv6 address <WAN-IP6>/<WAN-PREFIX>
 ipv6 traffic-filter WAN-VPN6-IN in
 ipv6 mtu 1280
 ipv6 nd ra suppress all
 ipv6 tcp adjust-mss 1300
!
! Option B: use an SVI when the WAN-facing module/port operates at Layer 2.
! Remove Option A if using this alternative. Confirm platform support.
interface <WAN-INT>
 switchport access vlan <VLAN>
!
interface Vlan<VLAN>
 ip address <WAN-IP> <WAN-SUBNET>
 ip access-group WAN-VPN-IN in
 ip tcp adjust-mss 1300
 load-interval 30
 ipv6 address <WAN-IP6>/<WAN-PREFIX>
 ipv6 traffic-filter WAN-VPN6-IN in
 ipv6 mtu 1280
 ipv6 nd ra suppress all
 ipv6 tcp adjust-mss 1300
!
